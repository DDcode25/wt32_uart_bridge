build/
.pio/
# PlatformIO генерирует sdkconfig.<env>, idf.py — просто sdkconfig.
# Оба собираются из sdkconfig.defaults, который и хранится в репозитории.
sdkconfig
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock
test/test
*.o

# Конфигурация VS Code генерируется расширением PlatformIO под конкретную
# машину: в c_cpp_properties.json, launch.json и settings.json лежат
# абсолютные пути вида /home/<user>/.platformio/..., на другом компьютере
# они не значат ничего. Файлы попали в репозиторий по недосмотру.
.vscode/
